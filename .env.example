APP_PASSWORD=REPLACE_WITH_AT_LEAST_16_RANDOM_CHARACTERS
COOKIE_SECURE=true
AWS_REGIONS=us-east-1,us-west-2,ap-northeast-1,ap-northeast-2,ap-southeast-1,eu-west-1
DATA_DIR=/app/data
MONITOR_INTERVAL_SECONDS=300
ALERT_COOLDOWN_SECONDS=3600
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# V6 task worker poll interval (seconds)
TASK_POLL_SECONDS=3
TASK_CONCURRENCY=5
